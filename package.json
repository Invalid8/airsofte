{
  "name": "airsofte",
  "version": "1.1.6",
  "description": "A retro shooter game",
  "type": "module",
  "homepage": "https://airsofte.vercel.app",
  "author": "dalgoridim <b.fadamitan2019@gmail.com> (https://dantolu33.vercel.app)",
  "keywords": [
    "Game",
    "Retro Shooter",
    "Fighter Jets"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:tauri": "tauri dev",
    "tauri": "tauri",
    "build": "npm run build:web",
    "build:web": "vite build --config vite.web.config.ts",
    "build:tauri": "tauri build --bundles deb,rpm",
    "build:tauri:all": "tauri build",
    "preview": "vite preview",
    "audit:assets": "node scripts/airsofte-asset-audit.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "npm run typecheck:node && npm run check",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@vercel/analytics": "^1.6.1",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "tailwindcss": "^4.1.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.0.0",
    "@tailwindcss/vite": "^4.1.5",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.14.1",
    "autoprefixer": "^10.4.21",
    "eslint-config-prettier": "^10.1.8",
    "eslint": "^9.24.0",
    "eslint-plugin-svelte": "^3.5.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.26.1",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.2.6",
    "vite-plugin-pwa": "^1.2.0"
  }
}
